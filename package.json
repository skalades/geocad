{
  "name": "georoad-cad",
  "private": true,
  "version": "1.0.0",
  "description": "GeoRoad CAD - WebGIS & Penampang Jalan",
  "author": "Putri",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.georoadcad.app",
    "productName": "GeoRoad CAD",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GeoRoad CAD"
    }
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.56.0",
    "proj4": "^2.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
